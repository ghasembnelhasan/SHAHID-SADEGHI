<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1220">
  <title>اردوی ناظم | حلقه قاسم ابن الحسن</title>
  <style>
:root{--bg:#0b1220;--panel:#121d31;--panel2:#182740;--gold:#e6bd72;--cream:#f7f1e5;--muted:#b9c5d6;--line:rgba(230,189,114,.22)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Tahoma,Arial,sans-serif;background:radial-gradient(ellipse at top,#1b3150 0%,var(--bg) 58%);color:var(--cream);line-height:1.9;min-height:100vh}
a{color:inherit;text-decoration:none}.wrap{width:min(1100px,92%);margin:auto}.topbar{padding:22px 0;border-bottom:1px solid var(--line)}.brand{color:var(--gold);font-weight:bold;letter-spacing:.3px}.hero{padding:76px 0 58px;text-align:center}.eyebrow{color:var(--gold);font-size:.92rem;letter-spacing:1px}.hero h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1.5;margin:12px 0}.hero p{max-width:680px;margin:0 auto 28px;color:var(--muted);font-size:1.05rem}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 27px;border-radius:12px;background:linear-gradient(135deg,#f0d49c,#d6a94e);color:#1b1b1b;font-weight:bold;border:0;transition:.2s;box-shadow:0 8px 24px #0004}.btn:hover{transform:translateY(-3px);filter:brightness(1.06)}.btn.secondary{background:transparent;color:var(--gold);border:1px solid var(--gold);box-shadow:none}
.section{padding:28px 0 70px}.section-title{text-align:center;margin-bottom:28px}.section-title h2{font-size:1.7rem;margin:0}.section-title p{color:var(--muted);margin:5px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}.card{background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:0 15px 35px #0003}.card .symbol{font-size:1.8rem;color:var(--gold)}.card h3{margin:7px 0;color:var(--cream)}.card p{color:var(--muted);margin:0 0 17px}.meta{display:flex;flex-wrap:wrap;gap:9px;margin:20px 0}.tag{padding:5px 12px;border:1px solid var(--line);border-radius:999px;color:var(--gold);font-size:.9rem}
.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:28px}.gallery figure{margin:0;background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden}.gallery img{display:block;width:100%;height:230px;object-fit:cover;background:#25344a}.gallery figcaption{padding:9px 12px;color:var(--muted);font-size:.9rem}
.notice{border-right:3px solid var(--gold);padding:12px 16px;background:#ffffff08;border-radius:10px;color:var(--muted);margin:22px 0}.back{display:inline-block;color:var(--gold);margin:18px 0}.footer{border-top:1px solid var(--line);padding:20px 0;text-align:center;color:var(--muted);font-size:.9rem}
@media(max-width:600px){.hero{padding:52px 0 38px}.card{padding:19px}.gallery img{height:200px}}
</style>
</head>
